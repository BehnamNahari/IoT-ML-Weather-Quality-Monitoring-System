--cpu Cortex-M3
"co2\startup_stm32f103xb.o"
"co2\main.o"
"co2\stm32f1xx_it.o"
"co2\stm32f1xx_hal_msp.o"
"co2\stm32f1xx_hal_gpio_ex.o"
"co2\stm32f1xx_hal_adc.o"
"co2\stm32f1xx_hal_adc_ex.o"
"co2\stm32f1xx_hal.o"
"co2\stm32f1xx_hal_rcc.o"
"co2\stm32f1xx_hal_rcc_ex.o"
"co2\stm32f1xx_hal_gpio.o"
"co2\stm32f1xx_hal_dma.o"
"co2\stm32f1xx_hal_cortex.o"
"co2\stm32f1xx_hal_pwr.o"
"co2\stm32f1xx_hal_flash.o"
"co2\stm32f1xx_hal_flash_ex.o"
"co2\stm32f1xx_hal_exti.o"
"co2\stm32f1xx_hal_uart.o"
"co2\system_stm32f1xx.o"
--strict --scatter "CO2\CO2.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "CO2.map" -o CO2\CO2.axf